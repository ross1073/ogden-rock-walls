---
import business from '../data/business.json';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, canonicalPath, ogImage, schema = [], noindex = false } = Astro.props;
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, business.url).href;
const ogImageURL = ogImage || `${business.url}/images/og-default.webp`;

const dayOrder = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
const dayMap: Record<string, string> = {
  Mo: "Monday", Tu: "Tuesday", We: "Wednesday",
  Th: "Thursday", Fr: "Friday", Sa: "Saturday", Su: "Sunday"
};

function expandDayRange(abbrev: string): string[] {
  if (!abbrev.includes('-')) return [dayMap[abbrev] || abbrev];
  const [start, end] = abbrev.split('-');
  const startIdx = dayOrder.indexOf(start);
  const endIdx = dayOrder.indexOf(end);
  if (startIdx === -1 || endIdx === -1) return [abbrev];
  return dayOrder.slice(startIdx, endIdx + 1).map(d => dayMap[d]);
}

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${business.url}/#business`,
  "name": business.name,
  "description": `Professional retaining wall contractors serving Ogden, UT and surrounding areas. ${business.yearsInBusiness} years of experience.`,
  "url": business.url,
  "telephone": business.phone,
  "email": business.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": business.address.street,
    "addressLocality": business.address.city,
    "addressRegion": business.address.state,
    "postalCode": business.address.zip,
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": business.geo.latitude,
    "longitude": business.geo.longitude
  },
  "openingHoursSpecification": business.hours.schema.map((h: string) => {
    const [days, times] = h.split(' ');
    const [opens, closes] = times.split('-');
    return {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": expandDayRange(days),
      "opens": opens,
      "closes": closes
    };
  }),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "47",
    "bestRating": "5",
    "worstRating": "1"
  },
  "parentOrganization": {
    "@type": "Organization",
    "name": business.legalName,
    "url": "https://accuriteexcavation.com"
  },
  "areaServed": business.serviceAreas.map((city: string) => ({
    "@type": "City",
    "name": city,
    "containedInPlace": { "@type": "State", "name": "Utah" }
  })),
  "priceRange": "$$",
  "sameAs": [
    "https://www.google.com/maps/place/AccuRite+Excavation+%26+Hauling"
  ]
};

const allSchemas = [localBusinessSchema, ...schema];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Ogden Rock Walls</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | Ogden Rock Walls`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CGFS2E9GES"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-CGFS2E9GES');
  </script>

  <!-- Schema -->
  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body class="min-h-screen flex flex-col">
  <slot />
</body>
</html>
