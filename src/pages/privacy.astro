---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import business from '../data/business.json';
---

<BaseLayout title="Privacy Policy" description="Privacy policy for Ogden Rock Walls. How we collect, use, and protect your information.">
  <Header />
  <main>
    <section class="bg-charcoal-dark py-16">
      <div class="max-w-4xl mx-auto px-4 prose prose-invert prose-headings:font-heading prose-headings:text-white prose-p:text-gray-300">
        <h1>Privacy Policy</h1>
        <p><em>Last updated: March 2026</em></p>

        <h2>Information We Collect</h2>
        <p>When you contact us through our website form, phone, or email, we collect the information you provide, including your name, phone number, email address, property address, and details about your project.</p>

        <h2>How We Use Your Information</h2>
        <p>We use your information to respond to your inquiries, provide estimates, schedule and perform services, and communicate about your project. We do not sell or share your personal information with third parties for marketing purposes.</p>

        <h2>Contact Form</h2>
        <p>Our contact form is provided by a third-party service (Lead Connector/GoHighLevel). Information submitted through the form is processed by their platform and shared with us for the purpose of responding to your inquiry. Their privacy practices are governed by their own privacy policy.</p>

        <h2>Cookies and Analytics</h2>
        <p>Our website may use cookies and analytics tools to understand how visitors use our site. This information is used to improve our website and is not linked to personal information.</p>

        <h2>Data Security</h2>
        <p>We take reasonable measures to protect your personal information from unauthorized access, disclosure, or misuse. Our website uses HTTPS encryption for secure data transmission.</p>

        <h2>Your Rights</h2>
        <p>You may request access to, correction of, or deletion of your personal information by contacting us. We will respond to your request within a reasonable timeframe.</p>

        <h2>Contact</h2>
        <p>If you have questions about this privacy policy, contact us at:</p>
        <p>
          {business.name}<br />
          {business.address.full}<br />
          <a href={business.phoneTel} class="text-gold">{business.phoneFormatted}</a><br />
          <a href={`mailto:${business.email}`} class="text-gold">{business.email}</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
