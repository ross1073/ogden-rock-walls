---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABanner from '../components/CTABanner.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Our Work"
  description="View retaining wall projects completed by Ogden Rock Walls across Northern Utah. Boulder walls, block walls, erosion control, and more."
>
  <Header />
  <main>
    <Breadcrumbs items={[{ label: 'Gallery', href: '/gallery' }]} />

    <section class="bg-charcoal-dark py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white text-center mb-4 uppercase">Our Work</h1>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto text-lg">
          Photos of retaining wall projects we've completed across Northern Utah.
        </p>

        <!-- Placeholder grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[1,2,3,4,5,6].map(i => (
            <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light flex items-center justify-center">
              <div class="text-center">
                <svg class="w-12 h-12 text-charcoal-light mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-gray-500 text-sm">Project photo coming soon</p>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center mt-12">
          <p class="text-gray-400 mb-4">We're updating our gallery with recent project photos. Check back soon.</p>
          <a href="/contact" class="inline-flex items-center justify-center bg-gold hover:bg-gold-dark text-charcoal-dark font-bold py-3 px-8 rounded transition-colors">
            Request a Free Estimate
          </a>
        </div>
      </div>
    </section>

    <CTABanner />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
