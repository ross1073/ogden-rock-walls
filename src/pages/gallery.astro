---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABanner from '../components/CTABanner.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Retaining Wall Projects in Ogden, UT"
  description="View retaining wall projects completed by Ogden Rock Walls across Northern Utah. Boulder walls, block walls, erosion control, and more."
  noindex={true}
>
  <Header />
  <main>
    <Breadcrumbs items={[{ label: 'Gallery', href: '/gallery' }]} />

    <section class="bg-charcoal-dark py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white text-center mb-4 uppercase">Retaining Wall Projects</h1>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto text-lg">
          Photos of retaining wall projects we've completed across Northern Utah.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/action-proof.png" alt="Boulder retaining wall installation in progress in Ogden, UT" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/hq-exterior.png" alt="Ogden Rock Walls headquarters and equipment yard in Ogden, Utah" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/team-photo.png" alt="Ogden Rock Walls retaining wall crew on a job site in Northern Utah" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/truck-local.png" alt="Ogden Rock Walls branded truck delivering materials to a retaining wall job site" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/shop-interior.png" alt="Ogden Rock Walls shop with excavation equipment for retaining wall projects" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="aspect-[4/3] bg-charcoal rounded-lg border border-charcoal-light overflow-hidden">
            <img src="/images/logo-square.png" alt="Ogden Rock Walls company logo - retaining wall contractors in Ogden, UT" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>

        <div class="text-center mt-12">
          <a href="/contact" class="inline-flex items-center justify-center bg-gold hover:bg-gold-dark text-charcoal-dark font-bold py-3 px-8 rounded transition-colors">
            Request a Free Estimate
          </a>
        </div>
      </div>
    </section>

    <CTABanner />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
