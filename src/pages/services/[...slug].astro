---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import CTABanner from '../../components/CTABanner.astro';
import ContactForm from '../../components/ContactForm.astro';
import LocationCard from '../../components/LocationCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import business from '../../data/business.json';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id.replace(/\.md$/, '') },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await service.render();

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const otherServices = allServices.filter(s => s.id !== service.id);

const locations = [
  { city: 'Ogden', href: '/locations/ogden' },
  { city: 'North Ogden', href: '/locations/north-ogden' },
  { city: 'South Ogden', href: '/locations/south-ogden' },
  { city: 'Roy', href: '/locations/roy' },
  { city: 'Layton', href: '/locations/layton' },
  { city: 'Clearfield', href: '/locations/clearfield' },
  { city: 'Syracuse', href: '/locations/syracuse' },
  { city: 'Kaysville', href: '/locations/kaysville' },
  { city: 'Farmington', href: '/locations/farmington' },
  { city: 'Bountiful', href: '/locations/bountiful' },
  { city: 'Morgan', href: '/locations/morgan' },
  { city: 'Eden', href: '/locations/eden' },
  { city: 'Brigham City', href: '/locations/brigham-city' },
  { city: 'Perry', href: '/locations/perry' },
  { city: 'West Haven', href: '/locations/west-haven' },
  { city: 'Plain City', href: '/locations/plain-city' },
  { city: 'Riverdale', href: '/locations/riverdale' },
  { city: 'Washington Terrace', href: '/locations/washington-terrace' },
  { city: 'Huntsville', href: '/locations/huntsville' },
];

const serviceFAQs: Record<string, {question: string, answer: string}[]> = {
  "Rock & Boulder Retaining Walls": [
    { question: "How much do boulder retaining walls cost in Ogden?", answer: "Boulder retaining wall costs in the Ogden area typically range from $25-$50 per square foot of wall face, depending on boulder size, wall height, and site access. We provide free on-site estimates with exact pricing for your specific project." },
    { question: "How long do boulder retaining walls last?", answer: "Properly installed boulder retaining walls last 50-100+ years. Natural rock doesn't rot, rust, or deteriorate like timber or concrete block. The key to longevity is correct drainage installation behind the wall, which we include on every project." },
    { question: "Do boulder retaining walls need a permit in Ogden?", answer: "In Ogden and Weber County, retaining walls over 4 feet in height typically require a building permit and may need engineered plans. We handle the permit process and work with local engineers when required." },
  ],
  "Concrete Block Retaining Walls": [
    { question: "How much do block retaining walls cost in Ogden?", answer: "Block retaining walls in the Ogden area typically cost $20-$40 per square foot of wall face, depending on block type, wall height, and site conditions. Segmental blocks are the most common choice. CMU walls with rebar and grout cost more but support heavier loads. We provide free estimates with detailed pricing for your project." },
    { question: "What is the maximum height for a block retaining wall?", answer: "Standard gravity block walls can reach 4-6 feet. Taller walls require geogrid soil reinforcement, which allows block retaining walls to reach 20+ feet. Walls over 4 feet in Ogden typically need a building permit and engineered design." },
    { question: "How long do block retaining walls last?", answer: "Quality block retaining walls last 50+ years when properly installed with adequate drainage. The blocks themselves are rated for extreme freeze-thaw cycles common in northern Utah winters." },
    { question: "What is the difference between cinder block and segmental block retaining walls?", answer: "Cinder blocks are lightweight, hollow concrete blocks that require rebar and grout fill for structural retaining walls. Segmental retaining wall (SRW) blocks are solid, interlocking units designed specifically for retaining walls — they're heavier, lock together mechanically, and don't require mortar. For most residential retaining walls in Ogden, segmental blocks are the better choice." },
    { question: "Do block retaining walls need drainage?", answer: "Yes — drainage is critical for any block retaining wall. Without proper drainage, water saturates the soil behind the wall and creates hydrostatic pressure that can push the wall forward. We install drain rock, perforated pipe, and filter fabric behind every block wall we build. Ogden's clay soil makes this especially important." },
    { question: "Can you build a block retaining wall on a slope?", answer: "Yes. Block retaining walls are commonly used to create level terraces on sloped properties in the Ogden foothills. We often build stepped or tiered block walls to work with the natural grade while creating usable flat areas for landscaping, patios, or play areas." },
  ],
  "Retaining Wall Repair": [
    { question: "How do I know if my retaining wall needs repair?", answer: "Warning signs include leaning or tilting, horizontal cracks, bulging sections, water seeping through the wall face, and soil erosion behind or beneath the wall. If you notice any of these, call for a free assessment before the damage worsens." },
    { question: "Can a leaning retaining wall be fixed without replacing it?", answer: "It depends on the severity. Minor leaning can sometimes be corrected with soil anchors or tiebacks. Walls leaning more than 2 inches per foot of height usually need full replacement. We assess each wall individually and recommend the most cost-effective solution." },
    { question: "What causes retaining walls to fail?", answer: "The most common cause in Ogden is poor drainage. Clay soil holds water, building hydrostatic pressure behind the wall until it pushes the wall forward. Other causes include inadequate wall design for the soil load, tree root damage, and frost heave from northern Utah winters." },
  ],
  "Drainage Solutions": [
    { question: "Why is drainage important for retaining walls?", answer: "Water is the number one cause of retaining wall failure. Without proper drainage, water saturates the soil behind the wall, creating hydrostatic pressure that pushes the wall forward. Ogden's clay soil makes this especially critical because clay holds water instead of draining it." },
    { question: "What type of drainage do you install behind retaining walls?", answer: "Every wall we build includes a French drain system with perforated pipe, filter fabric, and clean angular drain rock. We remove native clay soil from behind the wall and replace it with free-draining material. Weep holes through the wall face provide additional pressure relief." },
    { question: "How much does a drainage system cost?", answer: "Drainage is included in every retaining wall we build — it's not an add-on. For standalone drainage projects like French drains or yard drainage systems, costs typically range from $25-$50 per linear foot depending on depth and complexity." },
  ],
  "Erosion Control": [
    { question: "What causes erosion on my property in Ogden?", answer: "Ogden's steep terrain, spring snowmelt runoff, and clay soil create ideal conditions for erosion. Water flows downhill, picks up speed on steep grades, and carries away topsoil. Without intervention, erosion undermines foundations, driveways, and existing retaining walls." },
    { question: "What is the best erosion control method for steep slopes?", answer: "For steep slopes in the Ogden area, structural retaining walls combined with proper drainage are the most permanent solution. We also use riprap, erosion control blankets, and terracing depending on the slope grade and soil conditions." },
    { question: "Does erosion control increase property value?", answer: "Yes. Erosion control protects your home's foundation and creates usable yard space on sloped properties. Properties with properly engineered retaining walls and drainage consistently appraise higher than properties with uncontrolled slopes and erosion damage." },
  ],
  "Landscape Grading": [
    { question: "What is landscape grading?", answer: "Landscape grading is the process of reshaping the terrain on your property to control water flow, create level areas, and prepare ground for construction. Proper grading directs water away from foundations and prevents pooling in your yard." },
    { question: "How much does grading cost in Ogden?", answer: "Landscape grading in the Ogden area typically costs $1,500-$5,000 for residential projects, depending on the area size, amount of soil to move, and whether retaining walls are needed to hold the new grades. We provide free estimates." },
    { question: "Do I need grading before building a retaining wall?", answer: "Often yes. Proper grading behind and in front of a retaining wall ensures water drains away correctly and the wall performs as designed. We handle grading and wall construction together as a complete project." },
  ],
  "Commercial Projects": [
    { question: "Do you handle commercial retaining wall projects?", answer: "Yes. We build retaining walls for commercial properties, HOA developments, road construction, parking lots, and multi-unit residential projects throughout the Ogden metro area. We work with general contractors, developers, and property managers." },
    { question: "Can you work from engineered plans?", answer: "Absolutely. We regularly build from engineer-stamped plans and work directly with geotechnical and structural engineers. For projects requiring engineered design, we can recommend local engineers we've partnered with on past projects." },
    { question: "What is your largest retaining wall project?", answer: "We've built retaining wall systems exceeding 500 linear feet with wall heights over 15 feet for commercial and residential developments in Weber and Davis counties. Our equipment fleet handles projects of any scale." },
  ],
};

const currentFAQs = serviceFAQs[service.data.title] || [];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.data.title,
  "description": service.data.shortDescription,
  "provider": {
    "@type": "LocalBusiness",
    "@id": `${business.url}/#business`
  },
  "areaServed": business.serviceAreas.map((city: string) => ({
    "@type": "City",
    "name": city,
    "containedInPlace": { "@type": "State", "name": "Utah" }
  }))
};
---

<BaseLayout
  title={service.data.metaTitle}
  description={service.data.metaDescription}
  schema={[serviceSchema]}
>
  <Header />
  <main>
    <Breadcrumbs items={[
      { label: 'Services', href: '/services' },
      { label: service.data.title, href: `/services/${service.id.replace(/\.md$/, '')}` }
    ]} />

    <Hero title={`${service.data.title} in Ogden, UT`} subtitle={service.data.shortDescription} backgroundImage={service.data.heroImage} />

    <!-- Content -->
    <section class="bg-charcoal-dark py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Main content -->
          <div class="lg:col-span-2 prose prose-invert prose-gold max-w-none
            prose-headings:font-heading prose-headings:uppercase prose-headings:text-white
            prose-p:text-gray-300 prose-li:text-gray-300
            prose-strong:text-white prose-a:text-gold hover:prose-a:text-gold-light">
            <Content />

            {/* Service images gallery */}
            {service.data.images && service.data.images.length > 0 && (
              <div class="not-prose mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {service.data.images.map((img: {src: string, alt: string}) => (
                  <div class="rounded-lg overflow-hidden border border-charcoal-light">
                    <img src={img.src} alt={img.alt} class="w-full h-48 sm:h-56 object-cover" loading="lazy" width="400" height="224" />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="space-y-6">
            <div class="bg-charcoal rounded-lg p-6 border border-charcoal-light">
              <h3 class="font-heading text-lg font-bold text-white mb-4 uppercase">Other Services</h3>
              <ul class="space-y-2">
                {otherServices.map(s => (
                  <li>
                    <a href={`/services/${s.id.replace(/\.md$/, '')}`} class="text-gray-300 hover:text-gold transition-colors text-sm">
                      {s.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-gold rounded-lg p-6">
              <h3 class="font-heading text-lg font-bold text-charcoal-dark mb-2 uppercase">Free Estimate</h3>
              <p class="text-charcoal text-sm mb-4">Get a no-obligation quote for your project.</p>
              <a href="/contact" class="block text-center bg-charcoal-dark hover:bg-charcoal text-white font-bold py-2.5 px-4 rounded transition-colors text-sm">
                Request a Quote
              </a>
              <a href={business.phoneTel} class="block text-center mt-2 text-charcoal-dark font-bold text-sm">
                or call {business.phoneFormatted}
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {currentFAQs.length > 0 && (
      <FAQSection faqs={currentFAQs} heading={`${service.data.title} FAQ`} />
    )}

    <!-- Service Areas -->
    <section class="bg-charcoal py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="font-heading text-2xl font-bold text-white text-center mb-6 uppercase">
          We Offer {service.data.title} in These Areas
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {locations.map(l => (
            <LocationCard city={l.city} href={l.href} />
          ))}
        </div>
      </div>
    </section>

    <CTABanner />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
