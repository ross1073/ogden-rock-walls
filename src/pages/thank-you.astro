---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import business from '../data/business.json';
---

<BaseLayout
  title="Thank You"
  description="Thank you for contacting Ogden Rock Walls. We'll reach out within one business day to discuss your retaining wall project."
>
  <Header />
  <main>
    <section class="bg-charcoal-dark py-24">
      <div class="max-w-2xl mx-auto px-4 text-center">
        <div class="w-20 h-20 bg-gold/10 rounded-full flex items-center justify-center mx-auto mb-8">
          <svg class="w-10 h-10 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4 uppercase">Thank You</h1>
        <p class="text-gray-300 text-lg mb-8">
          We received your request and will reach out within one business day to discuss your retaining wall project.
        </p>

        <div class="bg-charcoal rounded-lg p-6 border border-charcoal-light mb-8">
          <p class="text-white font-medium mb-2">Need to talk sooner?</p>
          <a href={business.phoneTel} class="text-gold hover:text-gold-light text-2xl font-heading font-bold">
            Call {business.phoneFormatted}
          </a>
          <p class="text-gray-400 text-sm mt-2">{business.hours.display}</p>
        </div>

        <a href="/" class="inline-flex items-center justify-center bg-gold hover:bg-gold-dark text-charcoal-dark font-bold py-3 px-8 rounded transition-colors">
          Back to Homepage
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
