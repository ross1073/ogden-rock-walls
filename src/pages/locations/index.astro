---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABanner from '../../components/CTABanner.astro';
import ContactForm from '../../components/ContactForm.astro';

const locations = await getCollection('locations');

const counties: Record<string, typeof locations> = {};
for (const loc of locations) {
  const county = loc.data.county;
  if (!counties[county]) counties[county] = [];
  counties[county].push(loc);
}

const countyOrder = ['Weber', 'Davis', 'Box Elder', 'Morgan'];
---

<BaseLayout
  title="Service Areas"
  description="Ogden Rock Walls serves Weber, Davis, Box Elder, and Morgan counties. Retaining wall installation and repair across 18+ communities in Northern Utah."
>
  <Header />
  <main>
    <Breadcrumbs items={[{ label: 'Service Areas', href: '/locations' }]} />

    <section class="bg-charcoal-dark py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white text-center mb-4 uppercase">
          Service Areas
        </h1>
        <p class="text-gray-400 text-center mb-12 max-w-3xl mx-auto text-lg">
          We build and repair retaining walls across Northern Utah. From the Wasatch foothills to the valley floor, we know the terrain and soil conditions in every community we serve.
        </p>

        {countyOrder.map(county => counties[county] && (
          <div class="mb-12">
            <h2 class="font-heading text-2xl font-bold text-gold mb-6 uppercase">{county} County</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {counties[county].map(loc => (
                <a href={`/locations/${loc.id.replace(/\.md$/, '')}`} class="group block bg-charcoal rounded-lg p-5 border border-charcoal-light hover:border-gold transition-all duration-200">
                  <h3 class="font-heading text-lg font-bold text-white group-hover:text-gold transition-colors mb-1">
                    {loc.data.city}, UT
                  </h3>
                  <p class="text-gray-400 text-sm">{loc.data.terrain}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <CTABanner />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
