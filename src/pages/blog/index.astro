---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Retaining Wall Blog | Ogden Rock Walls"
  description="Expert advice on retaining walls in Utah — costs, permits, materials, maintenance, and more from Ogden Rock Walls."
>
  <Header />

  <section class="bg-charcoal-dark py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="font-heading text-4xl font-bold text-white mb-4">Retaining Wall Blog</h1>
      <p class="text-gray-400 text-lg mb-12">Expert advice on retaining walls, materials, permits, and property improvement in northern Utah.</p>

      <div class="space-y-8">
        {posts.map(post => (
          <article class="bg-charcoal rounded-lg p-6 border border-charcoal-light hover:border-gold transition-colors">
            <a href={`/blog/${post.slug}`} class="block">
              <time class="text-gold text-sm font-medium">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <h2 class="font-heading text-2xl font-bold text-white mt-2 mb-3 hover:text-gold transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-400 leading-relaxed">{post.data.excerpt}</p>
              <span class="inline-block mt-4 text-gold font-medium text-sm">Read More →</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
