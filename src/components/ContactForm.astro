---
interface Props {
  title?: string;
}

const { title = "Get Your Free Estimate" } = Astro.props;
---

<section class="bg-charcoal-dark py-16" id="contact-form">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white text-center mb-8 uppercase">
      {title}
    </h2>
    <div class="bg-charcoal rounded-lg p-6 border border-charcoal-light" style="min-height: 700px;">
      <iframe
        src="https://api.leadconnectorhq.com/widget/form/0FCCK6bwJLQttlSPKufv"
        style="width:100%;height:100%;border:none;border-radius:3px"
        id="inline-0FCCK6bwJLQttlSPKufv"
        data-layout="{'id':'INLINE'}"
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name="Rock Wall Opt In"
        data-height="669"
        data-layout-iframe-id="inline-0FCCK6bwJLQttlSPKufv"
        data-form-id="0FCCK6bwJLQttlSPKufv"
        title="Rock Wall Opt In"
      ></iframe>
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
    </div>
  </div>
</section>
