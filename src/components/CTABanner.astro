---
import business from '../data/business.json';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Ready to Get Started?", subtitle = "Call for a free estimate today" } = Astro.props;
---

<section class="bg-gold py-12">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-charcoal-dark mb-2 uppercase">{title}</h2>
    <p class="text-charcoal text-lg mb-6">{subtitle}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={business.phoneTel} class="inline-flex items-center justify-center bg-charcoal-dark hover:bg-charcoal text-white font-bold py-3 px-8 rounded text-lg transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call {business.phoneFormatted}
      </a>
      <a href="/contact" class="inline-flex items-center justify-center border-2 border-charcoal-dark text-charcoal-dark hover:bg-charcoal-dark hover:text-white font-bold py-3 px-8 rounded text-lg transition-colors">
        Request a Quote
      </a>
    </div>
  </div>
</section>
