---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="group block bg-charcoal rounded-lg p-6 border border-charcoal-light hover:border-gold transition-all duration-200 hover:shadow-lg hover:shadow-gold/10">
  <h3 class="font-heading text-xl font-bold text-white group-hover:text-gold transition-colors mb-2 uppercase">
    {title}
  </h3>
  <p class="text-gray-400 text-sm leading-relaxed">{description}</p>
  <span class="inline-block mt-4 text-gold text-sm font-medium group-hover:translate-x-1 transition-transform">
    Learn More &rarr;
  </span>
</a>
