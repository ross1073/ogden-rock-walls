---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a href={href} class="group block bg-charcoal rounded-lg border border-charcoal-light hover:border-gold transition-all duration-200 hover:shadow-lg hover:shadow-gold/10 overflow-hidden">
  {image && (
    <div class="h-44 overflow-hidden">
      <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
    </div>
  )}
  <div class="p-6">
    <h3 class="font-heading text-xl font-bold text-white group-hover:text-gold transition-colors mb-2 uppercase">
      {title}
    </h3>
    <p class="text-gray-400 text-sm leading-relaxed">{description}</p>
    <span class="inline-block mt-4 text-gold text-sm font-medium group-hover:translate-x-1 transition-transform">
      Learn More &rarr;
    </span>
  </div>
</a>
