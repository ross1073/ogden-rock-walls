---
interface Testimonial {
  quote: string;
  name: string;
  city: string;
}

interface Props {
  testimonials?: Testimonial[];
}

const defaultTestimonials: Testimonial[] = [
  {
    quote: "They came out, assessed the slope behind our house, and had a massive boulder wall in place within a week. It completely transformed our backyard.",
    name: "Mike R.",
    city: "Ogden"
  },
  {
    quote: "Our old retaining wall was leaning badly after years of drainage issues. They tore it out, fixed the drainage, and built a new wall that looks incredible.",
    name: "Sarah T.",
    city: "Layton"
  },
  {
    quote: "Professional from start to finish. They handled the grading and wall installation for our commercial property. On time and on budget.",
    name: "David K.",
    city: "Roy"
  }
];

const { testimonials = defaultTestimonials } = Astro.props;
---

<section class="bg-charcoal py-16">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white text-center mb-10 uppercase">
      What Our Clients Say
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map(t => (
        <div class="bg-charcoal-dark rounded-lg p-6 border border-charcoal-light">
          <div class="text-gold text-3xl mb-3">&ldquo;</div>
          <p class="text-gray-300 text-sm leading-relaxed mb-4">{t.quote}</p>
          <div class="border-t border-charcoal-light pt-3">
            <p class="text-white font-medium text-sm">{t.name}</p>
            <p class="text-gray-500 text-xs">{t.city}, UT</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
