---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  heading?: string;
}

const { faqs, heading = "Frequently Asked Questions" } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="bg-charcoal py-16">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-heading text-2xl font-bold text-white text-center mb-8 uppercase">{heading}</h2>
    <div class="space-y-4">
      {faqs.map(faq => (
        <details class="bg-charcoal-dark rounded-lg border border-charcoal-light group">
          <summary class="flex items-center justify-between cursor-pointer p-5 text-white font-medium hover:text-gold transition-colors">
            {faq.question}
            <svg class="w-5 h-5 text-gold flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-gray-300 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
