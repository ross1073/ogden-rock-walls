---
import business from '../data/business.json';

const serviceLinks = [
  { name: 'Rock & Boulder Retaining Walls', href: '/services/rock-boulder-retaining-walls' },
  { name: 'Concrete Block Retaining Walls', href: '/services/concrete-block-retaining-walls' },
  { name: 'Retaining Wall Repair', href: '/services/retaining-wall-repair' },
  { name: 'Drainage Solutions', href: '/services/drainage-solutions' },
  { name: 'Erosion Control', href: '/services/erosion-control' },
  { name: 'Landscape Grading', href: '/services/landscape-grading' },
  { name: 'Commercial Projects', href: '/services/commercial-projects' },
];

const locationLinks = [
  { name: 'North Ogden', href: '/locations/north-ogden' },
  { name: 'South Ogden', href: '/locations/south-ogden' },
  { name: 'Roy', href: '/locations/roy' },
  { name: 'Layton', href: '/locations/layton' },
  { name: 'Clearfield', href: '/locations/clearfield' },
  { name: 'Syracuse', href: '/locations/syracuse' },
  { name: 'Kaysville', href: '/locations/kaysville' },
  { name: 'Farmington', href: '/locations/farmington' },
  { name: 'Bountiful', href: '/locations/bountiful' },
  { name: 'Morgan', href: '/locations/morgan' },
  { name: 'Eden', href: '/locations/eden' },
  { name: 'Brigham City', href: '/locations/brigham-city' },
  { name: 'Perry', href: '/locations/perry' },
  { name: 'West Haven', href: '/locations/west-haven' },
  { name: 'Plain City', href: '/locations/plain-city' },
  { name: 'Riverdale', href: '/locations/riverdale' },
  { name: 'Washington Terrace', href: '/locations/washington-terrace' },
  { name: 'Huntsville', href: '/locations/huntsville' },
];
---

<header class="bg-charcoal-dark sticky top-0 z-50 shadow-lg">
  <!-- Top bar -->
  <div class="bg-charcoal text-gray-300 text-sm py-1.5 hidden md:block">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <span>{business.hours.display}</span>
      <div class="flex items-center gap-4">
        <a href={`mailto:${business.email}`} class="hover:text-gold transition-colors">{business.email}</a>
        <a href={business.phoneTel} class="hover:text-gold transition-colors">{business.phoneFormatted}</a>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <span class="font-heading text-2xl font-bold text-white tracking-wide">
        OGDEN <span class="text-gold">ROCK WALLS</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-6">
      <a href="/" class="text-gray-200 hover:text-gold transition-colors font-medium">Home</a>

      <!-- Services dropdown -->
      <div class="relative group">
        <button class="text-gray-200 hover:text-gold transition-colors font-medium flex items-center gap-1">
          Services
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-2 w-72 bg-charcoal-dark rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-charcoal-light">
          <div class="py-2">
            <a href="/services" class="block px-4 py-2 text-gray-300 hover:text-gold hover:bg-charcoal transition-colors text-sm font-medium border-b border-charcoal-light">All Services</a>
            {serviceLinks.map(link => (
              <a href={link.href} class="block px-4 py-2 text-gray-300 hover:text-gold hover:bg-charcoal transition-colors text-sm">
                {link.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Locations dropdown -->
      <div class="relative group">
        <button class="text-gray-200 hover:text-gold transition-colors font-medium flex items-center gap-1">
          Service Areas
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-2 w-80 bg-charcoal-dark rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-charcoal-light">
          <div class="py-2 grid grid-cols-2 gap-0">
            <a href="/locations" class="block col-span-2 px-4 py-2 text-gray-300 hover:text-gold hover:bg-charcoal transition-colors text-sm font-medium border-b border-charcoal-light">All Service Areas</a>
            {locationLinks.map(link => (
              <a href={link.href} class="block px-4 py-1.5 text-gray-300 hover:text-gold hover:bg-charcoal transition-colors text-sm">
                {link.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/about" class="text-gray-200 hover:text-gold transition-colors font-medium">About</a>
      <a href="/gallery" class="text-gray-200 hover:text-gold transition-colors font-medium">Gallery</a>
      <a href="/contact" class="text-gray-200 hover:text-gold transition-colors font-medium">Contact</a>
    </div>

    <!-- CTA + Mobile toggle -->
    <div class="flex items-center gap-3">
      <a href={business.phoneTel} class="hidden sm:inline-flex items-center gap-2 bg-gold hover:bg-gold-dark text-charcoal-dark font-bold py-2 px-4 rounded transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call Now
      </a>

      <!-- Hamburger -->
      <button id="mobile-toggle" class="lg:hidden text-white p-2" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-charcoal-dark border-t border-charcoal-light">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-3">
      <a href="/" class="block text-gray-200 hover:text-gold py-1">Home</a>

      <div>
        <p class="text-gold font-medium text-sm uppercase tracking-wider mb-1">Services</p>
        {serviceLinks.map(link => (
          <a href={link.href} class="block text-gray-300 hover:text-gold py-1 pl-3 text-sm">{link.name}</a>
        ))}
      </div>

      <div>
        <p class="text-gold font-medium text-sm uppercase tracking-wider mb-1">Service Areas</p>
        <div class="grid grid-cols-2 gap-x-4">
          {locationLinks.map(link => (
            <a href={link.href} class="block text-gray-300 hover:text-gold py-1 pl-3 text-sm">{link.name}</a>
          ))}
        </div>
      </div>

      <a href="/about" class="block text-gray-200 hover:text-gold py-1">About</a>
      <a href="/gallery" class="block text-gray-200 hover:text-gold py-1">Gallery</a>
      <a href="/contact" class="block text-gray-200 hover:text-gold py-1">Contact</a>

      <div class="pt-3 border-t border-charcoal-light space-y-2">
        <a href={business.phoneTel} class="block text-center bg-gold hover:bg-gold-dark text-charcoal-dark font-bold py-2.5 px-4 rounded transition-colors">
          Call {business.phoneFormatted}
        </a>
        <a href="/contact" class="block text-center border border-gold text-gold hover:bg-gold hover:text-charcoal-dark font-bold py-2.5 px-4 rounded transition-colors">
          Get Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
